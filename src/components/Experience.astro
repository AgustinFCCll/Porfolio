---
import ExperienceItem from "./ExperienceItem.astro";
const EXPERIENCE = [
  {
    date: "Actualidad",
    title: "Technical Support & Help Desk",
    company: "Focasoftware",
    description:
      "Tecnico, soporte y mantenimiento de aplicaciones. Corrección de errores, manejo de bases de datos y optimización de rendimiento.",
    link: "https://focasoftware.com/",
  },
];
---

<ol class="relative mt-16">
  {
    EXPERIENCE.map((experience) => (
      <li class="">
        <ExperienceItem {...experience} />
      </li>
    ))
  }
</ol>
