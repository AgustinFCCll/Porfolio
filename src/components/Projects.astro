---
import GitHub from "./icons/GitHub.astro"
import NetIcon from "./icons/net.astro"
import Link from "./icons/Link.astro"
import LinkButton from "./LinkButton.astro"
import CodeIcon from "./icons/Code.astro"
import PythonIcon from "./icons/Python.astro"
import FastAPIcon from "./icons/FastAPI.astro"

const TAGS = {
  DOTNET: {
    name: ".NET",
    class: "bg-[#512BD4] text-white",
    icon: NetIcon,
  },
  REACT: {
    name: "React",
    class: "bg-[#61DAFB] text-black",
    icon: CodeIcon,
  },
  PYTHON: {
    name: "Python",
    class: "bg-[#3776AB] text-white",
    icon: PythonIcon,
  },
  FASTAPI: {
    name: "FastAPI",
    class: "bg-[#009688] text-white",
    icon: FastAPIcon,
  },
} 
const PROJECTS = [
  {
    title: "Sistema Winforms",
    description:
      "Aplicación de escritorio desarrollada en WinForms con .NET que permite la gestión eficiente de artículos en un inventario ",
    link: "",
    github: "",
    image: "/projects/1739032523410.webp",
    tags: [TAGS.DOTNET],
  },
  {
    title: "Biblioteca",
    description:
      "API REST desarrollada con .NET Core, base de datos SQlite, React. Permite filtrar, buscar y agregar libros. Se ejecuta localmente",
    link: "",
    github: "https://github.com/AgustinFCCll/Stock-Libros",
    image: "/projects/Biblioteca.webp",
    tags: [TAGS.REACT, TAGS.DOTNET],
  },
  {
    title: "Transcriptor de YouTube",
    description:
      "Convierte videos de YouTube en documentos PDF o HTML usando subtítulos automáticos. ",
    link: "",
    github: "https://github.com/AgustinFCCll/Video-a-PDF-Transcriptor-de-YouTube",
    image: "/projects/Transcriptor.webp",
    tags: [TAGS.PYTHON, TAGS.REACT, TAGS.FASTAPI],
  },
]
---

<div class="flex flex-col gap-y-16">
  {
    PROJECTS.map(({ image, title, description, tags, link, github }) => (
    <article class="flex flex-col space-x-0 space-y-8 group md:flex-row md:space-x-8 md:space-y-0">
  <div class="w-full md:w-1/2">
    <div class="relative flex flex-col items-center col-span-6 row-span-5 gap-8 transition duration-500 ease-in-out transform shadow-xl overflow-clip rounded-xl sm:rounded-xl md:group-hover:-translate-y-1 md:group-hover:shadow-2xl lg:border lg:border-gray-800 lg:hover:border-gray-700 lg:hover:bg-gray-800/50 h-64 md:h-80">
      <img
        alt={title}
        class="object-cover w-full h-full transition duration-500 md:scale-110 md:group-hover:scale-105"
        loading="lazy"
        src={image}
      />
    </div>
  </div>

  <div class="w-full md:w-1/2 md:max-w-lg">
    <h3 class="text-2xl font-bold text-gray-800 dark:text-gray-100">
      {title}
    </h3>
    <div class="flex flex-wrap mt-2">
      <ul class="flex flex-row mb-2 gap-x-2">
          {tags.map((tag) => (
            <li>
              <span
                class={`flex gap-x-2 rounded-full text-xs ${tag.class} py-1 px-2 `}
              >
                <tag.icon class="size-4" />
                {tag.name}
              </span>
            </li>
          ))}
        </ul>

      <div class="mt-2 text-gray-700 dark:text-gray-400">{description}</div>
      <footer class="flex items-end justify-start mt-4 gap-x-4">
          {github && (
            <LinkButton href={github}>
              <GitHub class="size-6" />
              Code
              
            </LinkButton>
          )}
          {link && (
            <LinkButton href={link}>
              <Link class="size-4" />
              Preview
            </LinkButton>
          )}
        </footer>
    </div>
  </div>
</article>
    ))
  }
</div>



